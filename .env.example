# Copy to .env and `source .env`, or export these in your shell.

# --- Analysis backend ---
# Priority when backend="auto": gemini > groq > anthropic > heuristic (always works).
# Gemini free tier has the most generous daily quota -- get a key at aistudio.google.com.
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-3.5-flash-lite     # the -lite models are ~5x faster than full flash

# Groq is also free (console.groq.com) but each model has a ~200k tokens/day cap.
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=openai/gpt-oss-20b

# ANTHROPIC_API_KEY=sk-ant-...
# ANALYSIS_MODEL=claude-sonnet-4-6

# --- Whisper (speech-to-text) ---
# GPU (recommended for the full 1,441-call batch):
# WHISPER_DEVICE=cuda
# WHISPER_COMPUTE=float16
# WHISPER_MODEL=small        # small | medium (medium = better on banking terms, slower)

# CPU (default — fine for a handful of calls, too slow for the full set):
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE=int8

# --- Paths (optional overrides) ---
# CALLRADAR_DATA=./data
# CALLRADAR_DB=./callradar.db
